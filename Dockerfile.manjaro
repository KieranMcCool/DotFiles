FROM manjarolinux/base:latest

# Install basic utilities
RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm bash zsh neovim cronie git sudo curl nodejs npm

# Create a user for testing
RUN useradd -ms /bin/bash testuser

# Allow testuser to use the package manager only
RUN echo 'testuser ALL=(ALL) NOPASSWD: /usr/bin/pacman' > /etc/sudoers.d/testuser && \
    chmod 440 /etc/sudoers.d/testuser

# Copy dotfiles repo into container and fix ownership (must be done as root)
WORKDIR /home/testuser
COPY . /home/testuser/dotfiles
WORKDIR /home/testuser/dotfiles
RUN chmod +x install.sh && \
    chown -R testuser:testuser /home/testuser

USER testuser
WORKDIR /home/testuser/dotfiles

# Run install script
RUN ./install.sh install

# Set up cron using the provided cronfile
RUN crontab /home/testuser/.cronfile

RUN nvim --headless "+Lazy! sync" +qa

# Start bash by default
CMD ["bash"]
