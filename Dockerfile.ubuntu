FROM ubuntu:latest

# Install basic utilities and dotnet (available in Ubuntu 26.04+ official repos)
RUN apt-get update && \
    apt-get install -y bash zsh neovim cron git curl nodejs npm libicu-dev dotnet-sdk-10.0 aspnetcore-runtime-10.0 sudo && \
    rm -rf /var/lib/apt/lists/*

# Create a user for testing
RUN useradd -ms /bin/bash testuser

# Allow testuser to use the package manager only
RUN echo 'testuser ALL=(ALL) NOPASSWD: /usr/bin/apt-get, /usr/bin/apt' > /etc/sudoers.d/testuser && \
    chmod 440 /etc/sudoers.d/testuser
WORKDIR /home/testuser

# Copy dotfiles repo into container (as root)
COPY . /home/testuser/dotfiles
WORKDIR /home/testuser/dotfiles

# Make install.sh executable (as root)
RUN chmod +x install.sh

# Change ownership to testuser
RUN chown -R testuser:testuser /home/testuser

# Switch to testuser
USER testuser
WORKDIR /home/testuser/dotfiles

# Run install script
RUN ./install.sh install

RUN nvim --headless "+Lazy! sync" +qa

# Start bash by default
CMD ["bash"]
